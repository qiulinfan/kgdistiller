{
  "schema": "kgdistiller-workflows-v1",
  "product": "kgdistiller",
  "version": 2,
  "installation": {
    "product_root": "workflow-products/kgdistiller",
    "state": ".kgdistiller-product-links.json"
  },
  "workflow_guide": "docs/product-workflows.md",
  "workflow_resources": [
    "docs/concepts-and-relations.md",
    "docs/paper-sheets-upstream.md",
    "docs/latex-sources.md"
  ],
  "linkers": [
    {
      "platform": "posix",
      "path": "scripts/link-codex-product.sh"
    },
    {
      "platform": "windows",
      "path": "scripts/link-codex-product.ps1"
    }
  ],
  "skills": [
    {
      "name": "compile-knowledge-sheets",
      "path": "skills/compile-knowledge-sheets"
    },
    {
      "name": "curate-kgdistiller-notes",
      "path": "skills/curate-kgdistiller-notes"
    },
    {
      "name": "deploy-kgdistiller",
      "path": "skills/deploy-kgdistiller"
    },
    {
      "name": "distill-paper",
      "path": "skills/distill-paper"
    },
    {
      "name": "harvest-paper",
      "path": "skills/harvest-paper"
    },
    {
      "name": "ingest-kgdistiller",
      "path": "skills/ingest-kgdistiller"
    },
    {
      "name": "paper-related-work",
      "path": "skills/paper-related-work"
    },
    {
      "name": "query-kgdistiller",
      "path": "skills/query-kgdistiller"
    }
  ],
  "agents": [
    {
      "name": "note-curator",
      "path": ".codex/agents/note-curator.toml",
      "install_as": "kgdistiller-note-curator.toml"
    },
    {
      "name": "query-reviewer",
      "path": ".codex/agents/query-reviewer.toml",
      "install_as": "kgdistiller-query-reviewer.toml"
    },
    {
      "name": "related-work-scout",
      "path": ".codex/agents/related-work-scout.toml",
      "install_as": "kgdistiller-related-work-scout.toml"
    },
    {
      "name": "transaction-reviewer",
      "path": ".codex/agents/transaction-reviewer.toml",
      "install_as": "kgdistiller-transaction-reviewer.toml"
    }
  ],
  "workflows": [
    {
      "id": "compile-knowledge-sheets",
      "description": "Prepare source-grounded knowledge metadata updates and source-scoped definition/pending link views for notes, papers, blogs and project documents; apply only supported reviewed transactions.",
      "steps": [
        {
          "id": "compile",
          "skill": "compile-knowledge-sheets",
          "agent": null,
          "mode": "author"
        }
      ]
    },
    {
      "id": "curate-notes",
      "description": "Extract a bounded registered note set, resolve identities, and apply one reviewed transaction.",
      "steps": [
        {
          "id": "extract",
          "skill": "curate-kgdistiller-notes",
          "agent": "note-curator",
          "mode": "author"
        },
        {
          "id": "resolve",
          "skill": "query-kgdistiller",
          "agent": "query-reviewer",
          "mode": "read-only"
        },
        {
          "id": "commit",
          "skill": "ingest-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "transaction"
        }
      ]
    },
    {
      "id": "distill-paper",
      "description": "Explicit command: HTML-first source reading, short section guide, existing-knowledge links and candidates for user selection before import.",
      "steps": [
        {
          "id": "distill",
          "skill": "distill-paper",
          "agent": null,
          "mode": "author"
        }
      ]
    },
    {
      "id": "harvest-paper",
      "description": "Explicit command: static candidate review, native conversation selection and editing, then transactional import of confirmed content.",
      "steps": [
        {
          "id": "review-and-import",
          "skill": "harvest-paper",
          "agent": null,
          "mode": "transaction"
        }
      ]
    },
    {
      "id": "paper-related-work",
      "description": "Explicit command only: related-work research with bounded non-recursive scouts, grouped successors and source-backed explanations; no default time limit or natural-language activation.",
      "steps": [
        {
          "id": "research",
          "skill": "paper-related-work",
          "agent": "related-work-scout",
          "mode": "author"
        }
      ]
    },
    {
      "id": "portable-store",
      "description": "Create or verify a file-based portable generation with Markdown authorities and a query-ready JSON graph.",
      "steps": [
        {
          "id": "snapshot",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "transaction"
        },
        {
          "id": "verify",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "read-only"
        }
      ]
    },
    {
      "id": "publish-static",
      "description": "Verify a portable store and create a privacy-filtered, independently verifiable static site bundle.",
      "steps": [
        {
          "id": "verify",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "read-only"
        },
        {
          "id": "export",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "export"
        }
      ]
    },
    {
      "id": "export-obsidian",
      "description": "Create a lossy downstream Obsidian projection that is never registered or rescanned as authority.",
      "steps": [
        {
          "id": "verify",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "read-only"
        },
        {
          "id": "export",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "export"
        }
      ]
    }
  ]
}
