{
  "schema": "kgdistiller-claude-workflows-v1",
  "product": "kgdistiller",
  "version": 1,
  "installation": {
    "product_root": "workflow-products/kgdistiller",
    "state": ".kgdistiller-product-links.json"
  },
  "workflow_guide": "docs/product-workflows.md",
  "workflow_resources": [
    "docs/concepts-and-relations.md",
    "docs/paper-sheets-upstream.md",
    "docs/obsidian-hidden-knowledge.md"
  ],
  "linkers": [
    {
      "platform": "posix",
      "path": "scripts/link-claude-product.sh"
    },
    {
      "platform": "windows",
      "path": "scripts/link-claude-product.ps1"
    }
  ],
  "skills": [
    {
      "name": "capture-kgdistiller",
      "path": "skills/capture-kgdistiller"
    },
    {
      "name": "compile-knowledge-sheets",
      "path": "skills/compile-knowledge-sheets"
    },
    {
      "name": "curate-kgdistiller-notes",
      "path": "skills/curate-kgdistiller-notes"
    },
    {
      "name": "deploy-kgdistiller",
      "path": "skills/deploy-kgdistiller"
    },
    {
      "name": "harvest-paper",
      "path": "skills/harvest-paper"
    },
    {
      "name": "ingest-kgdistiller",
      "path": "skills/ingest-kgdistiller"
    },
    {
      "name": "query-kgdistiller",
      "path": "skills/query-kgdistiller"
    }
  ],
  "agents": [
    {
      "name": "note-curator",
      "path": ".claude/agents/note-curator.md",
      "install_as": "kgdistiller-note-curator.md"
    },
    {
      "name": "query-reviewer",
      "path": ".claude/agents/query-reviewer.md",
      "install_as": "kgdistiller-query-reviewer.md"
    },
    {
      "name": "transaction-reviewer",
      "path": ".claude/agents/transaction-reviewer.md",
      "install_as": "kgdistiller-transaction-reviewer.md"
    }
  ],
  "workflows": [
    {
      "id": "capture-knowledge",
      "description": "Capture one selected knowledge entry citing its source lines verbatim, preserve personal understanding and direct pending prerequisites, then apply one reviewed transaction without full-source distillation.",
      "steps": [
        {
          "id": "capture",
          "skill": "capture-kgdistiller",
          "agent": null,
          "mode": "author"
        },
        {
          "id": "commit",
          "skill": "ingest-kgdistiller",
          "agent": null,
          "mode": "transaction"
        }
      ]
    },
    {
      "id": "compile-knowledge-sheets",
      "description": "Prepare source-grounded knowledge metadata updates and source-scoped definition/pending link views for notes, papers, blogs and project documents; apply only supported reviewed transactions.",
      "steps": [
        {
          "id": "compile",
          "skill": "compile-knowledge-sheets",
          "agent": null,
          "mode": "author"
        }
      ]
    },
    {
      "id": "curate-notes",
      "description": "Extract entries and direct relations from a bounded set of registered text documents guided by their document type, resolve identities read-only, and apply one reviewed transaction.",
      "steps": [
        {
          "id": "extract",
          "skill": "curate-kgdistiller-notes",
          "agent": "note-curator",
          "mode": "author"
        },
        {
          "id": "resolve",
          "skill": "query-kgdistiller",
          "agent": "query-reviewer",
          "mode": "read-only"
        },
        {
          "id": "commit",
          "skill": "ingest-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "transaction"
        }
      ]
    },
    {
      "id": "harvest-paper",
      "description": "Explicit harvest request: ingest reviewed def-sheet tasks checked in Obsidian through the deterministic harvest helper and one transaction, after confirming their drafts, entries and cited source lines are unchanged; preserve unchecked content and understanding.",
      "steps": [
        {
          "id": "review-and-import",
          "skill": "harvest-paper",
          "agent": null,
          "mode": "transaction"
        }
      ]
    },
    {
      "id": "export-obsidian",
      "description": "Check entries and edges against their sources, then refresh the Obsidian plugin's typed graph feed (.knowledge/build/obsidian/semantic-graph.json) from every entry and accepted edge; it is never registered or rescanned as a source.",
      "steps": [
        {
          "id": "verify",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "read-only"
        },
        {
          "id": "export",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "export"
        }
      ]
    }
  ]
}
