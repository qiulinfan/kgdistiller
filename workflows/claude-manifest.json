{
  "schema": "kgdistiller-claude-workflows-v1",
  "product": "kgdistiller",
  "version": 2,
  "installation": {
    "product_root": "workflow-products/kgdistiller",
    "state": ".kgdistiller-product-links.json"
  },
  "workflow_guide": "docs/product-workflows.md",
  "workflow_resources": [
    "docs/model.md",
    "docs/retrieval.md",
    "docs/obsidian.md",
    "docs/deployment.md"
  ],
  "linkers": [
    {
      "platform": "posix",
      "path": "scripts/link-claude-product.sh"
    },
    {
      "platform": "windows",
      "path": "scripts/link-claude-product.ps1"
    }
  ],
  "skills": [
    {
      "name": "capture-kgdistiller",
      "path": "skills/capture-kgdistiller"
    },
    {
      "name": "compile-knowledge-sheets",
      "path": "skills/compile-knowledge-sheets"
    },
    {
      "name": "deploy-kgdistiller",
      "path": "skills/deploy-kgdistiller"
    },
    {
      "name": "harvest-kgdistiller",
      "path": "skills/harvest-kgdistiller"
    },
    {
      "name": "query-kgdistiller",
      "path": "skills/query-kgdistiller"
    }
  ],
  "agents": [
    {
      "name": "query-reviewer",
      "path": ".claude/agents/query-reviewer.md",
      "install_as": "kgdistiller-query-reviewer.md"
    }
  ],
  "workflows": [
    {
      "id": "capture-knowledge",
      "description": "Capture one selected item while reading as a source-backed record: write a draft citing its lines verbatim and accept it, or edit an existing record in place and check it, recording direct pending terms and only the owner's stated understanding, then index.",
      "steps": [
        {
          "id": "capture",
          "skill": "capture-kgdistiller",
          "agent": null,
          "mode": "write"
        }
      ]
    },
    {
      "id": "compile-knowledge-sheets",
      "description": "Extract draft records from a bounded scope of one registered source guided by its document type, check them and generate the source's def/pending sheet for owner review; changes to accepted records are only proposed.",
      "steps": [
        {
          "id": "compile",
          "skill": "compile-knowledge-sheets",
          "agent": null,
          "mode": "author"
        }
      ]
    },
    {
      "id": "harvest-kgdistiller",
      "description": "Accept the drafts the owner ticked in a source sheet with one kgd harvest call, report refused rows, then index.",
      "steps": [
        {
          "id": "harvest",
          "skill": "harvest-kgdistiller",
          "agent": null,
          "mode": "write"
        }
      ]
    },
    {
      "id": "query-knowledge",
      "description": "Search, resolve and read records across every registered base read-only, deliver source:lines with evidence quotes, classify candidate identity, and refresh the derived index only when results report lag.",
      "steps": [
        {
          "id": "query",
          "skill": "query-kgdistiller",
          "agent": "query-reviewer",
          "mode": "read-only"
        }
      ]
    },
    {
      "id": "deploy-kgdistiller",
      "description": "Register bases, source globs and document types in the home, check records against their sources, build or restore the derived index, install the Obsidian plugin and link the agent runtimes.",
      "steps": [
        {
          "id": "deploy",
          "skill": "deploy-kgdistiller",
          "agent": null,
          "mode": "write"
        }
      ]
    }
  ]
}
