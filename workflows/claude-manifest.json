{
  "schema": "kgdistiller-claude-workflows-v1",
  "product": "kgdistiller",
  "version": 1,
  "installation": {
    "product_root": "workflow-products/kgdistiller",
    "state": ".kgdistiller-product-links.json"
  },
  "workflow_guide": "docs/product-workflows.md",
  "linkers": [
    {
      "platform": "posix",
      "path": "scripts/link-claude-product.sh"
    },
    {
      "platform": "windows",
      "path": "scripts/link-claude-product.ps1"
    }
  ],
  "skills": [
    {
      "name": "curate-kgdistiller-notes",
      "path": "skills/curate-kgdistiller-notes"
    },
    {
      "name": "deploy-kgdistiller",
      "path": "skills/deploy-kgdistiller"
    },
    {
      "name": "distill-paper",
      "path": "skills/distill-paper"
    },
    {
      "name": "distill-paper-knowledge",
      "path": "skills/distill-paper-knowledge"
    },
    {
      "name": "harvest-paper",
      "path": "skills/harvest-paper"
    },
    {
      "name": "import-paper-knowledge",
      "path": "skills/import-paper-knowledge"
    },
    {
      "name": "ingest-kgdistiller",
      "path": "skills/ingest-kgdistiller"
    },
    {
      "name": "paper-related-work",
      "path": "skills/paper-related-work"
    },
    {
      "name": "query-kgdistiller",
      "path": "skills/query-kgdistiller"
    },
    {
      "name": "trace-concept-lineage",
      "path": "skills/trace-concept-lineage"
    }
  ],
  "agents": [
    {
      "name": "note-curator",
      "path": ".claude/agents/note-curator.md",
      "install_as": "kgdistiller-note-curator.md"
    },
    {
      "name": "paper-distiller",
      "path": ".claude/agents/paper-distiller.md",
      "install_as": "kgdistiller-paper-distiller.md"
    },
    {
      "name": "query-reviewer",
      "path": ".claude/agents/query-reviewer.md",
      "install_as": "kgdistiller-query-reviewer.md"
    },
    {
      "name": "related-work-scout",
      "path": ".claude/agents/related-work-scout.md",
      "install_as": "kgdistiller-related-work-scout.md"
    },
    {
      "name": "transaction-reviewer",
      "path": ".claude/agents/transaction-reviewer.md",
      "install_as": "kgdistiller-transaction-reviewer.md"
    }
  ],
  "workflows": [
    {
      "id": "curate-notes",
      "description": "Extract a bounded registered note set, resolve identities, and apply one reviewed transaction.",
      "steps": [
        {
          "id": "extract",
          "skill": "curate-kgdistiller-notes",
          "agent": "note-curator",
          "mode": "author"
        },
        {
          "id": "resolve",
          "skill": "query-kgdistiller",
          "agent": "query-reviewer",
          "mode": "read-only"
        },
        {
          "id": "commit",
          "skill": "ingest-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "transaction"
        }
      ]
    },
    {
      "id": "distill-paper",
      "description": "Explicit command: HTML-first source reading, short section guide, existing-knowledge links and candidates for user selection before import.",
      "steps": [
        {
          "id": "distill",
          "skill": "distill-paper",
          "agent": null,
          "mode": "author"
        }
      ]
    },
    {
      "id": "harvest-paper",
      "description": "Explicit command: static candidate review, native conversation selection and editing, then transactional import of confirmed content.",
      "steps": [
        {
          "id": "review-and-import",
          "skill": "harvest-paper",
          "agent": null,
          "mode": "transaction"
        }
      ]
    },
    {
      "id": "paper-related-work",
      "description": "Explicit command only: related-work research with bounded non-recursive scouts, grouped successors and source-backed explanations; no default time limit or natural-language activation.",
      "steps": [
        {
          "id": "research",
          "skill": "paper-related-work",
          "agent": "related-work-scout",
          "mode": "author"
        }
      ]
    },
    {
      "id": "federate-paper",
      "description": "Explicit advanced command: build an isolated paper graph from an existing source package and link concrete prerequisites.",
      "steps": [
        {
          "id": "distill",
          "skill": "distill-paper-knowledge",
          "agent": "paper-distiller",
          "mode": "author"
        },
        {
          "id": "align",
          "skill": "query-kgdistiller",
          "agent": "query-reviewer",
          "mode": "read-only"
        }
      ]
    },
    {
      "id": "import-paper",
      "description": "Import only selected methods and mechanisms while preserving paper-qualified identities and definitions.",
      "steps": [
        {
          "id": "select",
          "skill": "import-paper-knowledge",
          "agent": "paper-distiller",
          "mode": "author"
        },
        {
          "id": "revalidate",
          "skill": "query-kgdistiller",
          "agent": "query-reviewer",
          "mode": "read-only"
        },
        {
          "id": "commit",
          "skill": "ingest-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "transaction"
        }
      ]
    },
    {
      "id": "trace-lineage",
      "description": "Research paper-scoped methods and mechanisms and derive a prerequisite-ordered learning route.",
      "steps": [
        {
          "id": "trace",
          "skill": "trace-concept-lineage",
          "agent": "paper-distiller",
          "mode": "author"
        }
      ]
    },
    {
      "id": "portable-store",
      "description": "Create or verify a file-based portable generation with Markdown authorities and a query-ready JSON graph.",
      "steps": [
        {
          "id": "snapshot",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "transaction"
        },
        {
          "id": "verify",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "read-only"
        }
      ]
    },
    {
      "id": "publish-static",
      "description": "Verify a portable store and create a privacy-filtered, independently verifiable static site bundle.",
      "steps": [
        {
          "id": "verify",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "read-only"
        },
        {
          "id": "export",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "export"
        }
      ]
    },
    {
      "id": "export-obsidian",
      "description": "Create a lossy downstream Obsidian projection that is never registered or rescanned as authority.",
      "steps": [
        {
          "id": "verify",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "read-only"
        },
        {
          "id": "export",
          "skill": "deploy-kgdistiller",
          "agent": "transaction-reviewer",
          "mode": "export"
        }
      ]
    }
  ]
}
