{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/qlkg-document-upsert-request-v1.schema.json",
  "title": "kgdistiller reviewed annotated document upsert request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "request_sha256", "source", "document", "reviewed", "artifacts", "preconditions", "embedding", "targets"],
  "properties": {
    "schema": {"const": "qlkg-document-upsert-request-v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "source": {"$ref": "#/$defs/source"},
    "document": {"$ref": "#/$defs/document"},
    "reviewed": {"$ref": "#/$defs/reviewed"},
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "preconditions": {"$ref": "#/$defs/preconditions"},
    "embedding": {"$ref": "#/$defs/embedding"},
    "targets": {"$ref": "#/$defs/targets"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "nodeId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "documentId": {"type": "string", "minLength": 5, "maxLength": 256, "pattern": "^doc:[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!~)(?![A-Za-z][A-Za-z0-9+.-]*:)[^\\u0000\\r\\n]+$"
    },
    "localPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*[\\u0000\\r\\n]).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "authority", "registered_glob", "format", "source_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "authority": {"$ref": "#/$defs/relativePath"},
        "registered_glob": {"$ref": "#/$defs/relativePath"},
        "format": {"enum": ["md", "typ", "tex"]},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "matchEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "explicit-document-id"},
            "value": {"$ref": "#/$defs/documentId"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "external-id"},
            "value": {"type": "string", "minLength": 1, "maxLength": 1024}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "authority"},
            "value": {"$ref": "#/$defs/relativePath"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "content-sha256"},
            "value": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "matching_evidence"],
      "properties": {
        "document_id": {"oneOf": [{"$ref": "#/$defs/documentId"}, {"type": "null"}]},
        "matching_evidence": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/matchEvidence"}}
      },
      "anyOf": [
        {"properties": {"document_id": {"$ref": "#/$defs/documentId"}}},
        {"properties": {"matching_evidence": {"minItems": 1}}}
      ]
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "page": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "section": {"type": "string", "minLength": 1, "maxLength": 512},
        "equation": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "anyOf": [{"required": ["line"]}, {"required": ["page"]}, {"required": ["section"]}, {"required": ["equation"]}]
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "marker", "location"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nodeId"},
        "kind": {"enum": ["definition", "reference"]},
        "marker": {"type": "string", "minLength": 1, "maxLength": 512},
        "location": {"$ref": "#/$defs/sourceLocation"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "location", "evidence"],
      "properties": {
        "target_id": {"$ref": "#/$defs/nodeId"},
        "location": {"$ref": "#/$defs/sourceLocation"},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "label", "text", "claims"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nodeId"},
        "node_type": {"enum": ["knowledge", "field", "topic"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 1024},
        "text": {"type": "string", "minLength": 1, "maxLength": 16384},
        "claims": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "relation", "object_id", "evidence", "location"],
      "properties": {
        "subject_id": {"$ref": "#/$defs/nodeId"},
        "relation": {"enum": ["contains", "prerequisite-for", "implies", "generalizes", "contrasts-with", "derived-from"]},
        "object_id": {"$ref": "#/$defs/nodeId"},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 4096},
        "location": {"$ref": "#/$defs/sourceLocation"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "evidence"],
      "properties": {
        "status": {"const": "reviewed"},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 256},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
      }
    },
    "reviewed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markers", "references", "entries", "edges", "review"],
      "properties": {
        "markers": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/marker"}},
        "references": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/reference"}},
        "entries": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/entry"}},
        "edges": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/edge"}},
        "review": {"$ref": "#/$defs/review"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "query", "delta"],
      "properties": {
        "candidate": {"$ref": "#/$defs/artifact"},
        "query": {"$ref": "#/$defs/artifact"},
        "delta": {"$ref": "#/$defs/artifact"}
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_sha256", "source_sha256", "query_sha256", "document_sha256", "portable_generation_sha256"],
      "properties": {
        "graph_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/nullableSha256"},
        "query_sha256": {"$ref": "#/$defs/sha256"},
        "document_sha256": {"$ref": "#/$defs/nullableSha256"},
        "portable_generation_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "policy_sha256", "profile"],
      "properties": {
        "intent": {"enum": ["required", "best-effort", "skip"]},
        "policy_sha256": {"$ref": "#/$defs/nullableSha256"},
        "profile": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"intent": {"const": "skip"}}}, "then": {"properties": {"policy_sha256": {"type": "null"}, "profile": {"type": "null"}}}, "else": {"properties": {"policy_sha256": {"$ref": "#/$defs/sha256"}, "profile": {"type": "string", "minLength": 1}}}}
      ]
    },
    "portableTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "expected_generation_sha256"],
      "properties": {
        "store": {"$ref": "#/$defs/localPath"},
        "expected_generation_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "machineLocalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database"],
      "properties": {"database": {"$ref": "#/$defs/localPath"}}
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable", "machine_local"],
      "properties": {
        "portable": {"$ref": "#/$defs/portableTarget"},
        "machine_local": {"$ref": "#/$defs/machineLocalTarget"}
      }
    }
  }
}
