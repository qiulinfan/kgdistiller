{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/qlkg-embedding-bundle-v2.schema.json",
  "title": "kgdistiller portable embedding bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "embedding_input_schema", "dtype", "records", "objects", "providers", "embedding_generation_sha256"],
  "properties": {
    "schema": {"const": "qlkg-embedding-bundle-v2"},
    "embedding_input_schema": {"const": "qlkg-node-embedding-text-v1"},
    "dtype": {"const": "float32-le"},
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "count", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "count", "bytes", "sha256"],
      "properties": {
        "directory": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "dimensions", "dtype", "embedding_input_schema", "provider_config_sha256"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "dimensions": {"type": "integer", "minimum": 1},
          "dtype": {"const": "float32-le"},
          "embedding_input_schema": {"const": "qlkg-node-embedding-text-v1"},
          "provider_config_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "embedding_generation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
