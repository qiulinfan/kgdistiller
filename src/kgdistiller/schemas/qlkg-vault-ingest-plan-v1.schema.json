{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/qlkg-vault-ingest-plan-v1.schema.json",
  "title": "kgdistiller native Vault ingest plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_sha256", "request_id", "request_sha256", "vault_id", "registry_generation", "vault_manifest_sha256", "before", "after", "changes", "validations", "status"],
  "properties": {
    "schema": {"const": "qlkg-vault-ingest-plan-v1"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "vault_id": {"$ref": "#/$defs/vault_id"},
    "registry_generation": {"$ref": "#/$defs/sha256"},
    "vault_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "before": {"$ref": "#/$defs/state"},
    "after": {"$ref": "#/$defs/after_state"},
    "changes": {"$ref": "#/$defs/changes"},
    "validations": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/validation"}},
    "status": {"const": "ready"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "vault_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "portable_path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\u007f]+$"},
    "version_id": {"type": "string", "pattern": "^doc:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:v[0-9]{8}$"},
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ledger_generation_sha256", "graph_generation_sha256", "note_inventory_sha256"],
      "properties": {"source_ledger_generation_sha256": {"$ref": "#/$defs/nullable_sha256"}, "graph_generation_sha256": {"$ref": "#/$defs/nullable_sha256"}, "note_inventory_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "after_state": {
      "type": "object", "additionalProperties": false,
      "required": ["graph_generation_sha256", "note_inventory_sha256"],
      "properties": {"graph_generation_sha256": {"$ref": "#/$defs/sha256"}, "note_inventory_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "changes": {
      "type": "object", "additionalProperties": false, "required": ["note_paths", "derivation_version_ids"],
      "properties": {"note_paths": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/portable_path"}}, "derivation_version_ids": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/version_id"}}}
    },
    "validation": {
      "type": "object", "additionalProperties": false, "required": ["stage", "status"],
      "properties": {"stage": {"enum": ["request", "bindings", "notes", "evidence", "graph", "recompile"]}, "status": {"const": "passed"}}
    }
  }
}
