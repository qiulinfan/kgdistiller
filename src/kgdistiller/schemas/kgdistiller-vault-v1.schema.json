{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-vault-v1.schema.json",
  "title": "kgdistiller portable vault identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "vault_id"],
  "properties": {
    "schema": {"const": "kgdistiller-vault-v1"},
    "vault_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
