{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/qlkg-vault-ingest-journal-v1.schema.json",
  "title": "kgdistiller native Vault ingest recovery journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "journal_sha256", "state", "vault_id", "request_id", "request_sha256", "receipt_sha256", "stage", "registry_generation", "vault_manifest_sha256", "before", "after", "planned_directories", "created_directories", "targets"],
  "properties": {
    "schema": {"const": "qlkg-vault-ingest-journal-v1"},
    "journal_sha256": {"$ref": "#/$defs/sha256"},
    "state": {"enum": ["prepared", "rolling-back", "committed"]},
    "vault_id": {"$ref": "#/$defs/vault_id"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "stage": {"type": "string", "pattern": "^\\.stage-vault-ingest-[0-9a-f]{32}$"},
    "registry_generation": {"$ref": "#/$defs/sha256"},
    "vault_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "before": {"$ref": "#/$defs/state_token"},
    "after": {"$ref": "#/$defs/state_token"},
    "planned_directories": {"type": "array", "maxItems": 8192, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "created_directories": {"type": "array", "maxItems": 8192, "uniqueItems": true, "items": {"$ref": "#/$defs/directory_identity"}},
    "targets": {"type": "array", "minItems": 1, "maxItems": 100512, "items": {"$ref": "#/$defs/target"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "vault_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\u007f]+$"},
    "directory_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "device", "inode"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "device": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^(?:0|[1-9][0-9]*)$"},
        "inode": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^(?:0|[1-9][0-9]*)$"}
      }
    },
    "state_token": {"type": "object", "additionalProperties": false, "required": ["source_ledger_generation_sha256", "graph_generation_sha256", "note_inventory_sha256"], "properties": {"source_ledger_generation_sha256": {"$ref": "#/$defs/nullable_sha256"}, "graph_generation_sha256": {"$ref": "#/$defs/nullable_sha256"}, "note_inventory_sha256": {"$ref": "#/$defs/sha256"}}},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "existed", "old_bytes", "old_sha256", "new_bytes", "new_sha256", "backup_path", "staged_path", "temporary_path"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "existed": {"type": "boolean"},
        "old_bytes": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 536870912}, {"type": "null"}]}, "old_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "new_bytes": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 536870912}, {"type": "null"}]}, "new_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "backup_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]}, "staged_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "temporary_path": {"$ref": "#/$defs/path"}
      }
    }
  }
}
