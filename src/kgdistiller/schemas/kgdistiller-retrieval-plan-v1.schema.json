{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-retrieval-plan-v1.schema.json",
  "title": "kgdistiller bounded deterministic retrieval plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "question", "identity_queries", "lexical_queries", "graph", "limit"],
  "properties": {
    "schema": {"const": "kgdistiller-retrieval-plan-v1"},
    "question": {"type": "string", "minLength": 1, "maxLength": 8192},
    "identity_queries": {"$ref": "#/$defs/queries"},
    "lexical_queries": {"$ref": "#/$defs/queries"},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_ids", "edge_types", "direction", "max_depth", "strategy"],
      "properties": {
        "seed_ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "edge_types": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/edgeType"}},
        "direction": {"enum": ["out", "in", "both"]},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 8},
        "strategy": {"enum": ["bfs", "ppr", "hybrid"]}
      }
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 500}
  },
  "$defs": {
    "nodeId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "queries": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "edgeType": {"enum": ["prerequisite-for", "implies", "generalizes", "contrasts-with", "derived-from"]}
  }
}
