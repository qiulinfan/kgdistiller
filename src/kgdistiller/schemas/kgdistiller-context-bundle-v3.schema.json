{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-context-bundle-v3.schema.json",
  "title": "kgdistiller compact source-bound semantic context v3",
  "description": "Derived complete semantic node projections and original edge evidence stored once. Node records carry original fingerprints and a digest of projected content; packet steps reference edge indexes. Standalone digests are integrity metadata, not independent scientific review or proof of omitted-source content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projection",
    "namespace",
    "snapshot_sha256",
    "graph_sha256",
    "view_content_sha256",
    "plan_sha256",
    "execution_sha256",
    "question",
    "search_execution_schema",
    "search_result_schema",
    "edge_policy",
    "confidence_is_independent_review",
    "nodes",
    "edges",
    "references",
    "support_packets",
    "gaps",
    "omitted_support_packets",
    "diagnostics_truncated",
    "budget"
  ],
  "properties": {
    "schema": {
      "const": "kgdistiller-context-bundle-v3"
    },
    "projection": {
      "enum": [
        "kgdistiller-context-projection-v1",
        "kgdistiller-context-projection-full-v1"
      ]
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "graph_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "view_content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "execution_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "question": {
      "type": "string"
    },
    "search_execution_schema": {
      "enum": [
        "kgdistiller-search-execution-v1",
        "kgdistiller-search-execution-v2",
        "kgdistiller-search-execution-v3"
      ]
    },
    "search_result_schema": {
      "enum": [
        "kgdistiller-search-result-v1",
        "kgdistiller-search-result-v2",
        "kgdistiller-search-result-v3"
      ]
    },
    "edge_policy": {
      "enum": [
        "current",
        "high-confidence"
      ]
    },
    "confidence_is_independent_review": {
      "const": false
    },
    "nodes": {
      "type": "array",
      "maxItems": 4500,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/nodeRecord"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 4000,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/edgeRecord"
      }
    },
    "references": {
      "type": "array",
      "maxItems": 10000,
      "minItems": 0,
      "items": {
        "type": "object"
      }
    },
    "support_packets": {
      "type": "array",
      "maxItems": 564,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/packet"
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 564,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "omitted_support_packets": {
      "type": "integer",
      "minimum": 0,
      "maximum": 564
    },
    "diagnostics_truncated": {
      "type": "boolean"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_budget",
        "estimated_tokens"
      ],
      "properties": {
        "token_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        }
      }
    },
    "support_selection_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "edgeType": {
      "enum": [
        "prerequisite-for",
        "implies",
        "generalizes",
        "contrasts-with",
        "derived-from"
      ]
    },
    "nodeContent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "enum": [
            "knowledge"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "text": {
          "type": "string"
        },
        "properties": {
          "type": "object"
        },
        "entry": {
          "type": "object"
        },
        "provenance": {
          "type": "object"
        }
      }
    },
    "edgeContent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "relation",
        "target"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/nodeId"
        },
        "relation": {
          "$ref": "#/$defs/edgeType"
        },
        "target": {
          "$ref": "#/$defs/nodeId"
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "nodeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_sha256",
        "document_sha256",
        "projection_sha256",
        "content"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nodeId"
        },
        "node_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content": {
          "$ref": "#/$defs/nodeContent"
        }
      }
    },
    "edgeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_sha256",
        "content"
      ],
      "properties": {
        "edge_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content": {
          "$ref": "#/$defs/edgeContent"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_index",
        "direction"
      ],
      "properties": {
        "edge_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3999
        },
        "direction": {
          "enum": [
            "outgoing",
            "incoming"
          ]
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "kind",
        "nodes",
        "steps",
        "lane",
        "logical_entailment"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nodeId"
        },
        "kind": {
          "enum": [
            "direct-source",
            "graph-path"
          ]
        },
        "nodes": {
          "type": "array",
          "maxItems": 9,
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "steps": {
          "type": "array",
          "maxItems": 8,
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "lane": {
          "enum": [
            null,
            "graph",
            "ppr"
          ]
        },
        "logical_entailment": {
          "const": false
        },
        "selection_origin": {
          "const": "query-support"
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "reason"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nodeId"
        },
        "reason": {
          "const": "support-packet-exceeds-budget"
        }
      }
    }
  }
}
