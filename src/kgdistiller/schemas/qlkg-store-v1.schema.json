{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/qlkg-store-v1.schema.json",
  "title": "kgdistiller portable knowledge store v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "generator", "paths", "documents", "registry_sha256",
    "identity_sha256", "alignment_sha256", "graph_sha256",
    "embedding_manifest_sha256", "knowledge_generation_sha256",
    "embedding_generation_sha256", "store_generation_sha256",
    "managed_paths", "store_sha256"
  ],
  "properties": {
    "schema": {"const": "qlkg-store-v1"},
    "generator": {"const": "kgdistiller"},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "identities", "alignments", "graph", "documents", "embedding_manifest"],
      "properties": {
        "registry": {"$ref": "#/$defs/path"},
        "identities": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "alignments": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "graph": {"$ref": "#/$defs/path"},
        "documents": {"$ref": "#/$defs/path"},
        "embedding_manifest": {"$ref": "#/$defs/path"}
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sha256", "source_snapshot_sha256"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "identity_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "alignment_sha256": {"$ref": "#/$defs/sha256"},
    "graph_sha256": {"$ref": "#/$defs/sha256"},
    "embedding_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "knowledge_generation_sha256": {"$ref": "#/$defs/sha256"},
    "embedding_generation_sha256": {"$ref": "#/$defs/sha256"},
    "store_generation_sha256": {"$ref": "#/$defs/sha256"},
    "managed_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "store_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
