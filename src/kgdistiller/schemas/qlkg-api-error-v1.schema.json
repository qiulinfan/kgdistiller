{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/qlkg-api-error-v1.schema.json",
  "title": "kgdistiller versioned backend API error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "route", "vault_id", "error", "current_generation", "retryable"],
  "properties": {
    "schema": {"const": "qlkg-api-error-v1"},
    "status": {"const": "error"},
    "route": {
      "anyOf": [
        {"enum": ["status", "vaults", "roots", "node", "neighbors", "stale", "source", "versions", "diff", "excerpt", "search", "context"]},
        {"type": "null"}
      ]
    },
    "vault_id": {
      "anyOf": [
        {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        {"type": "null"}
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "current_generation": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "retryable": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
