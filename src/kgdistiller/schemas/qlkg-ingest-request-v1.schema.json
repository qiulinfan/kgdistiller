{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/qlkg-ingest-request-v1.schema.json",
  "title": "kgdistiller transactional ingest request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "request_sha256",
    "mode",
    "capabilities",
    "base_graph_sha256",
    "base_alignment_sha256",
    "candidate_snapshot",
    "query_report",
    "authority_patches",
    "decisions",
    "delta",
    "alignment_decisions",
    "review"
  ],
  "properties": {
    "schema": {"const": "qlkg-ingest-request-v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "mode": {"enum": ["plan", "apply"]},
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "contains": {"const": "transactional-ingest-v1"},
      "items": {"type": "string"}
    },
    "base_graph_sha256": {"$ref": "#/$defs/sha256"},
    "base_alignment_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_snapshot": {"$ref": "#/$defs/artifact"},
    "query_report": {"$ref": "#/$defs/artifact"},
    "authority_patches": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/authorityPatch"}
    },
    "decisions": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/decision"}
    },
    "delta": {
      "type": "object",
      "required": ["schema", "remove_nodes", "nodes", "edges", "remove_edges"],
      "properties": {
        "schema": {"const": "qlkg-agent-delta-v2"},
        "remove_nodes": {"type": "array", "maxItems": 4096},
        "nodes": {"type": "array", "maxItems": 4096},
        "edges": {"type": "array", "maxItems": 4096},
        "remove_edges": {"type": "array", "maxItems": 4096}
      }
    },
    "alignment_decisions": {
      "type": "array",
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/alignmentDecision"}
    },
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "markerState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitions", "references"],
      "properties": {
        "definitions": {"type": "array", "maxItems": 4096, "items": {"type": "string"}},
        "references": {"type": "array", "maxItems": 4096, "items": {"type": "string"}}
      }
    },
    "authorityPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation", "expected_sha256", "expected_markers"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "operation": {"enum": ["write", "delete"]},
        "expected_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "content": {"type": "string", "maxLength": 2097152},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "expected_markers": {"$ref": "#/$defs/markerState"}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "write"}}},
          "then": {"required": ["content", "content_sha256"]},
          "else": {"not": {"anyOf": [{"required": ["content"]}, {"required": ["content_sha256"]}]}}
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "action", "evidence"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "action": {"enum": ["reuse", "add", "update", "reject", "defer"]},
        "target_id": {"type": ["string", "null"]},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    },
    "alignmentDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "target_id", "predicate", "status", "justification", "evidence"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "predicate": {"enum": ["exact-match", "close-match", "broad-match", "narrow-match", "related-match", "different-from"]},
        "status": {"enum": ["reviewed", "rejected"]},
        "justification": {"type": "string", "minLength": 1, "maxLength": 16384},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 16384},
        "target_namespace": {"type": "string", "default": "personal"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "evidence", "provenance"],
      "properties": {
        "status": {"const": "reviewed"},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 16384},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 4096},
        "provenance": {"type": "array", "minItems": 1, "maxItems": 4096}
      }
    }
  }
}
