{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-obsidian-graph-v1.schema.json",
  "title": "kgdistiller Obsidian semantic graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "counts", "concepts", "sources", "semantic_edges", "definitions"],
  "properties": {
    "schema": {"const": "kgdistiller-obsidian-graph-v1"},
    "counts": {"$ref": "#/$defs/counts"},
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind", "aliases", "authority", "understanding"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "label": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "authority": {"$ref": "#/$defs/authority"},
          "understanding": {"enum": ["unknown", "not-yet-understood", "understood"]}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority"],
        "properties": {
          "authority": {"$ref": "#/$defs/authority"}
        }
      }
    },
    "semantic_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "relation", "target", "evidence"],
        "properties": {
          "source": {"$ref": "#/$defs/id"},
          "relation": {"enum": ["prerequisite-for", "implies", "generalizes", "contrasts-with", "derived-from"]},
          "target": {"$ref": "#/$defs/id"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_authority", "target", "line_start", "line_end"],
        "properties": {
          "source_authority": {"$ref": "#/$defs/authority"},
          "target": {"$ref": "#/$defs/id"},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "authority": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concepts", "sources", "semantic_edges", "definitions"],
      "properties": {
        "concepts": {"type": "integer", "minimum": 0},
        "sources": {"type": "integer", "minimum": 0},
        "semantic_edges": {"type": "integer", "minimum": 0},
        "definitions": {"type": "integer", "minimum": 0}
      }
    }
  }
}
