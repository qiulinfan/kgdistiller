{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-static-export-v1.schema.json",
  "title": "kgdistiller consumer-ready static export v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "producer", "source", "visibility", "graph", "artifacts", "export_sha256"],
  "properties": {
    "schema": {"const": "kgdistiller-static-export-v1"},
    "status": {"const": "exported"},
    "producer": {"$ref": "#/$defs/producer"},
    "source": {"$ref": "#/$defs/source"},
    "visibility": {"$ref": "#/$defs/visibility"},
    "graph": {"$ref": "#/$defs/graph"},
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/artifact"},
      "allOf": [
        {
          "contains": {
            "properties": {"kind": {"const": "site-graph"}, "path": {"const": "graph.json"}},
            "required": ["kind", "path"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {"kind": {"const": "typst-registry"}, "path": {"const": "knowledge-registry.typ"}},
            "required": ["kind", "path"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {"kind": {"const": "standalone-verifier"}, "path": {"const": "verify_export.py"}},
            "required": ["kind", "path"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "replaces_export_sha256": {"$ref": "#/$defs/sha256"},
    "export_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "repository": {"type": "string", "pattern": "^https://(?![^/]*@)[^?#\\s]+$", "maxLength": 2048},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "version", "commit"],
      "properties": {
        "name": {"const": "kgdistiller"},
        "repository": {"$ref": "#/$defs/repository"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "commit": {"$ref": "#/$defs/gitCommit"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "digest", "files", "published_digest", "published_files", "published_hashes"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "revision": {"$ref": "#/$defs/gitCommit"},
        "digest": {"$ref": "#/$defs/sha256"},
        "files": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "published_digest": {"$ref": "#/$defs/sha256"},
        "published_files": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "published_hashes": {
          "description": "SHA-256 of UTF-8 authority text after CRLF and CR are normalized to LF.",
          "type": "object",
          "maxProperties": 1000000,
          "propertyNames": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$", "maxLength": 4096},
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "published_sources", "excluded_sources"],
      "properties": {
        "policy": {"const": "explicit-publish"},
        "published_sources": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "excluded_sources": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "references"],
      "properties": {
        "nodes": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "edges": {"type": "integer", "minimum": 0, "maximum": 5000000},
        "references": {"type": "integer", "minimum": 0, "maximum": 5000000}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_schema", "private_sha256", "private_counts", "public_schema", "public_sha256", "public_counts"],
      "properties": {
        "private_schema": {"const": "kgdistiller-graph-v1"},
        "private_sha256": {"$ref": "#/$defs/sha256"},
        "private_counts": {"$ref": "#/$defs/counts"},
        "public_schema": {"const": "kgdistiller-site-graph-v1"},
        "public_sha256": {"$ref": "#/$defs/sha256"},
        "public_counts": {"$ref": "#/$defs/counts"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "bytes", "sha256"],
      "properties": {
        "kind": {"enum": ["site-graph", "typst-registry", "standalone-verifier"]},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$", "maxLength": 255},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 134217728, "description": "Length of the artifact's UTF-8 text after universal-newline normalization."},
        "sha256": {"$ref": "#/$defs/sha256", "description": "SHA-256 of the artifact's UTF-8 text after universal-newline normalization."}
      }
    }
  }
}
