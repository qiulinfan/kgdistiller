{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/qlkg-ingest-receipt-v2.schema.json",
  "title": "kgdistiller transactional ingest receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "request_id", "request_sha256", "receipt_sha256", "engine",
    "before", "after", "changes", "validations", "durations_ms", "warnings",
    "status"
  ],
  "properties": {
    "schema": {"const": "qlkg-ingest-receipt-v2"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "capabilities", "graph_schema", "query_backend"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "capabilities": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "graph_schema": {"const": "qlkg-v3"},
        "query_backend": {"const": "json-memory"}
      }
    },
    "before": {"$ref": "#/$defs/state"},
    "after": {"$ref": "#/$defs/state"},
    "changes": {"type": "object"},
    "validations": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stage", "status"],
        "properties": {
          "stage": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"const": "passed"}
        }
      }
    },
    "durations_ms": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "warnings": {"type": "array", "maxItems": 10000},
    "status": {"const": "committed"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["graph_sha256", "alignment_sha256", "source_hashes"],
      "properties": {
        "graph_sha256": {"$ref": "#/$defs/sha256"},
        "alignment_sha256": {"$ref": "#/$defs/sha256"},
        "source_hashes": {
          "type": "object", "maxProperties": 100000,
          "additionalProperties": {
            "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
          }
        }
      }
    }
  }
}
