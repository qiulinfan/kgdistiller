{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-ingest-request-v1.schema.json",
  "title": "kgdistiller transactional ingest request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "mode", "capabilities", "delta", "review"],
  "properties": {
    "schema": {"const": "kgdistiller-ingest-request-v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"},
    "mode": {"enum": ["plan", "apply"]},
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "contains": {"const": "transactional-ingest-v1"},
      "items": {"type": "string"}
    },
    "delta": {"$ref": "#/$defs/delta"},
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "line": {"type": "string", "minLength": 1, "maxLength": 16384},
    "lines": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/line"}},
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "create_entries", "update_entries", "remove_entries", "add_edges", "remove_edges"],
      "properties": {
        "schema": {"const": "kgdistiller-agent-delta-v1"},
        "create_entries": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/entry"}},
        "update_entries": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expected_label", "entry"],
            "properties": {
              "expected_label": {"$ref": "#/$defs/text"},
              "entry": {"$ref": "#/$defs/entry"}
            }
          }
        },
        "remove_entries": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "expected_label"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "expected_label": {"$ref": "#/$defs/text"}
            }
          }
        },
        "add_edges": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/edge"}},
        "remove_edges": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/edgeKey"}}
      }
    },
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 200},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "aliases", "source", "line_start", "line_end", "understanding", "summary", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 1024},
        "kind": {"type": "string", "minLength": 1, "maxLength": 1024},
        "aliases": {"type": "array", "maxItems": 1024, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "source": {"type": "string", "minLength": 1, "maxLength": 4096},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "understanding": {"enum": ["unknown", "not-yet-understood", "understood"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 65536},
        "context": {"type": "string", "maxLength": 65536},
        "role": {"type": "string", "maxLength": 65536},
        "prerequisites": {"$ref": "#/$defs/lines"},
        "pending_prerequisites": {"$ref": "#/$defs/lines"},
        "common_confusions": {"$ref": "#/$defs/lines"},
        "open_questions": {"$ref": "#/$defs/lines"},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 1048576}
      }
    },
    "edgeKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "relation", "target"],
      "properties": {
        "source": {"$ref": "#/$defs/id"},
        "relation": {"$ref": "#/$defs/relation"},
        "target": {"$ref": "#/$defs/id"}
      }
    },
    "relation": {"enum": ["prerequisite-for", "implies", "generalizes", "contrasts-with", "derived-from"]},
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "relation", "target", "origin", "confidence", "evidence"],
      "properties": {
        "source": {"$ref": "#/$defs/id"},
        "relation": {"$ref": "#/$defs/relation"},
        "target": {"$ref": "#/$defs/id"},
        "origin": {"$ref": "#/$defs/text"},
        "confidence": {"$ref": "#/$defs/text"},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "evidence", "provenance"],
      "properties": {
        "status": {"const": "reviewed"},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 16384},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 4096},
        "provenance": {"type": "array", "minItems": 1, "maxItems": 4096}
      }
    }
  }
}
