{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-search-result-v3.schema.json",
  "title": "kgdistiller source-bound graph exploration search result v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_sha256",
    "lanes",
    "results",
    "graph_retrieval"
  ],
  "properties": {
    "schema": {
      "const": "kgdistiller-search-result-v3"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "lexical",
        "graph",
        "ppr"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/queryLane"
        },
        "lexical": {
          "$ref": "#/$defs/queryLane"
        },
        "graph": {
          "$ref": "#/$defs/seedLane"
        },
        "ppr": {
          "$ref": "#/$defs/seedLane"
        },
        "embedding": {
          "$ref": "#/$defs/queryLane"
        },
        "reranker": {
          "$ref": "#/$defs/queryLane"
        }
      }
    },
    "results": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embedding"
      ],
      "properties": {
        "embedding": {
          "$ref": "#/$defs/embeddingProvenance"
        },
        "reranker": {
          "$ref": "#/$defs/rerankerProvenance"
        }
      }
    },
    "graph_retrieval": {
      "$ref": "#/$defs/graphRetrieval"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "edgeType": {
      "enum": [
        "prerequisite-for",
        "implies",
        "generalizes",
        "contrasts-with",
        "derived-from"
      ]
    },
    "status": {
      "enum": [
        "enabled",
        "disabled",
        "degraded",
        "error"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "queryLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "queries",
        "results"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "queries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "results": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "enabled"
              }
            }
          },
          "else": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "seedLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "seeds",
        "results"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "seeds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "results": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "enabled"
              }
            }
          },
          "else": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "laneEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "score"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "score": {
          "type": "number"
        }
      }
    },
    "resultLanes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 6,
      "properties": {
        "identity": {
          "$ref": "#/$defs/laneEvidence"
        },
        "lexical": {
          "$ref": "#/$defs/laneEvidence"
        },
        "graph": {
          "$ref": "#/$defs/laneEvidence"
        },
        "ppr": {
          "$ref": "#/$defs/laneEvidence"
        },
        "embedding": {
          "$ref": "#/$defs/laneEvidence"
        },
        "reranker": {
          "$ref": "#/$defs/laneEvidence"
        }
      }
    },
    "seedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "seed_id",
        "origin",
        "identity_authority"
      ],
      "properties": {
        "lane": {
          "enum": [
            "graph",
            "ppr"
          ]
        },
        "seed_id": {
          "$ref": "#/$defs/nodeId"
        },
        "origin": {
          "enum": [
            "explicit",
            "identity",
            "candidate"
          ]
        },
        "identity_authority": {
          "type": "boolean"
        }
      }
    },
    "pathEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "nodes",
        "edge_types",
        "node_bindings",
        "steps",
        "logical_entailment"
      ],
      "properties": {
        "lane": {
          "enum": [
            "graph",
            "ppr"
          ]
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "edge_types": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/edgeType"
          }
        },
        "node_bindings": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/nodeBinding"
          }
        },
        "steps": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/pathStep"
          }
        },
        "logical_entailment": {
          "const": false
        }
      }
    },
    "fusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "score",
        "explanation"
      ],
      "properties": {
        "method": {
          "enum": [
            "rrf",
            "weighted",
            "single-lane",
            "navigation"
          ]
        },
        "score": {
          "type": "number"
        },
        "explanation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "label",
        "lanes",
        "seed_evidence",
        "path_evidence",
        "fusion"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nodeId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "lanes": {
          "$ref": "#/$defs/resultLanes"
        },
        "seed_evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/seedEvidence"
          }
        },
        "path_evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/pathEvidence"
          }
        },
        "fusion": {
          "$ref": "#/$defs/fusion"
        }
      }
    },
    "modelDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "revision",
        "inference"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "inference": {
          "type": "object"
        }
      }
    },
    "embeddingProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "projection",
        "namespace",
        "snapshot_sha256",
        "graph_sha256",
        "index_sha256",
        "document_count",
        "dimensions",
        "cache_status",
        "query_source",
        "query_sha256",
        "cache_sha256"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/modelDescriptor"
        },
        "projection": {
          "const": "kgdistiller-search-document-v1"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "graph_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "index_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "document_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "dimensions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "cache_status": {
          "enum": [
            "hit",
            "miss",
            "empty"
          ]
        },
        "query_source": {
          "const": "plan.question"
        },
        "query_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cache_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "rerankerCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_sha256",
        "document_sha256",
        "score"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nodeId"
        },
        "node_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "score": {
          "type": "number"
        }
      }
    },
    "rerankerProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "projection",
        "namespace",
        "snapshot_sha256",
        "graph_sha256",
        "query_source",
        "query_sha256",
        "candidate_limit",
        "candidates",
        "fusion"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/modelDescriptor"
        },
        "projection": {
          "const": "kgdistiller-search-document-v1"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "graph_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "query_source": {
          "const": "plan.question"
        },
        "query_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "candidates": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/rerankerCandidate"
          }
        },
        "fusion": {
          "const": "rrf-base-reranker"
        }
      }
    },
    "nodeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_sha256",
        "document_sha256"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nodeId"
        },
        "node_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pathStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "relation",
        "target",
        "direction",
        "confidence",
        "curation_status",
        "evidence",
        "edge_sha256",
        "purpose",
        "logical_entailment"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/nodeId"
        },
        "relation": {
          "$ref": "#/$defs/edgeType"
        },
        "target": {
          "$ref": "#/$defs/nodeId"
        },
        "direction": {
          "enum": [
            "outgoing",
            "incoming"
          ]
        },
        "confidence": {
          "type": "string"
        },
        "curation_status": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "edge_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "purpose": {
          "enum": [
            "learning-prerequisite",
            "source-derivation",
            "comparison",
            "relation-navigation"
          ]
        },
        "logical_entailment": {
          "const": false
        }
      }
    },
    "candidateSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_sha256",
        "document_sha256",
        "base_rank",
        "base_score",
        "lanes",
        "identity_authority"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nodeId"
        },
        "node_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "base_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "base_score": {
          "type": "number"
        },
        "lanes": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "lexical": {
              "$ref": "#/$defs/laneEvidence"
            },
            "embedding": {
              "$ref": "#/$defs/laneEvidence"
            }
          }
        },
        "identity_authority": {
          "const": false
        }
      }
    },
    "graphPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_limit",
        "edge_policy",
        "confidence_gate",
        "confidence_is_independent_review",
        "max_depth",
        "ppr_max_iterations"
      ],
      "properties": {
        "candidate_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "edge_policy": {
          "enum": [
            "current",
            "high-confidence"
          ]
        },
        "confidence_gate": {
          "enum": [
            "none",
            "declared-high-with-evidence"
          ]
        },
        "confidence_is_independent_review": {
          "const": false
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "ppr_max_iterations": {
          "const": 256
        }
      }
    },
    "graphBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "snapshot_sha256",
        "graph_sha256",
        "plan_sha256",
        "view_content_sha256"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "graph_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "view_content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "graphRetrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "binding",
        "seeds",
        "ppr",
        "path_limit",
        "pipeline_version",
        "candidate_projection",
        "mode",
        "neighbor_limit",
        "neighbors_truncated",
        "neighbors"
      ],
      "properties": {
        "policy": {
          "$ref": "#/$defs/graphPolicy"
        },
        "binding": {
          "$ref": "#/$defs/graphBinding"
        },
        "seeds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "explicit",
            "identity",
            "candidate",
            "effective"
          ],
          "properties": {
            "explicit": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/nodeId"
              }
            },
            "identity": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/nodeId"
              }
            },
            "candidate": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/candidateSeed"
              }
            },
            "effective": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/nodeId"
              }
            }
          }
        },
        "ppr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "iterations",
            "converged",
            "final_l1_residual",
            "tolerance",
            "discarded_results",
            "stationary_error_bound",
            "probability_mass",
            "reachable_node_count",
            "allowed_edge_count"
          ],
          "properties": {
            "status": {
              "enum": [
                "disabled",
                "enabled",
                "degraded"
              ]
            },
            "iterations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "converged": {
              "type": "boolean"
            },
            "final_l1_residual": {
              "type": [
                "number",
                "null"
              ]
            },
            "tolerance": {
              "type": "number"
            },
            "discarded_results": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            },
            "stationary_error_bound": {
              "type": [
                "number",
                "null"
              ]
            },
            "probability_mass": {
              "type": [
                "number",
                "null"
              ]
            },
            "reachable_node_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "allowed_edge_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        },
        "path_limit": {
          "const": 32
        },
        "pipeline_version": {
          "const": "kgdistiller-graph-retrieval-v1"
        },
        "candidate_projection": {
          "const": "kgdistiller-search-document-v1"
        },
        "mode": {
          "const": "support-expansion"
        },
        "neighbor_limit": {
          "const": 32
        },
        "neighbors_truncated": {
          "type": "boolean"
        },
        "neighbors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      }
    }
  }
}
