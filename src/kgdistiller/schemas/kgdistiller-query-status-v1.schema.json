{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-query-status-v1.schema.json",
  "title": "kgdistiller entry store query status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "counts", "relations"],
  "properties": {
    "schema": {"const": "kgdistiller-query-status-v1"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "edges"],
      "properties": {
        "entries": {"type": "integer", "minimum": 0},
        "edges": {"type": "integer", "minimum": 0}
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prerequisite-for": {"type": "integer", "minimum": 0},
        "implies": {"type": "integer", "minimum": 0},
        "generalizes": {"type": "integer", "minimum": 0},
        "contrasts-with": {"type": "integer", "minimum": 0},
        "derived-from": {"type": "integer", "minimum": 0}
      }
    }
  }
}
