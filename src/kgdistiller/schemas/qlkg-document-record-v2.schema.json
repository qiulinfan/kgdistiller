{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/qlkg-document-record-v2.schema.json",
  "title": "kgdistiller stable portable document record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "document_id", "source_id", "authority", "authority_history", "format", "knowledge_origin", "external_ids", "source_sha256", "definition_ids", "reference_count"],
  "properties": {
    "schema": {"const": "qlkg-document-record-v2"},
    "document_id": {"$ref": "#/$defs/documentId"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "authority": {"$ref": "#/$defs/relativePath"},
    "authority_history": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
    "format": {"enum": ["md", "typ", "tex"]},
    "knowledge_origin": {"enum": ["personal-note", "research"]},
    "external_ids": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
      "properties": {
        "doi": {"oneOf": [{"type": "string", "minLength": 6, "maxLength": 256, "pattern": "^10\\.[0-9]{4,9}/[^\\s]+$"}, {"type": "null"}]},
        "arxiv": {"oneOf": [{"type": "string", "minLength": 5, "maxLength": 64, "pattern": "^(?:[a-z-]+/[0-9]{7}|[0-9]{4}\\.[0-9]{4,5})(?:v[0-9]+)?$"}, {"type": "null"}]}
      },
      "additionalProperties": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 256}, {"type": "null"}]}
    },
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "definition_ids": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
    "reference_count": {"type": "integer", "minimum": 0, "maximum": 1000000}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documentId": {"type": "string", "minLength": 5, "maxLength": 256, "pattern": "^doc:[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "nodeId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!~)(?![A-Za-z][A-Za-z0-9+.-]*:)[^\\u0000\\r\\n]+$"
    }
  }
}
