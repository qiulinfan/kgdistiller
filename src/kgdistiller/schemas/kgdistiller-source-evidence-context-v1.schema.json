{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-source-evidence-context-v1.schema.json",
  "title": "kgdistiller compact exact raw-source evidence context v1",
  "description": "Lossless sharing of source and heading metadata across validated retrievals. Fragments retain exact UTF-8 text and original span/projection hashes. Rank and score are local to original queries, never fused relevance. Hash and reference closure do not establish scientific truth, relevance, coverage or agreement with current source files. Complete external result/input hashes bind unselected trace; bounded omission diagnostics declare truncation. Packed fragments carry original per-query origins. Default selection is hash-bound without copying the candidate ID ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projection",
    "source_projection",
    "manifest_sha256",
    "manifest_file_sha256",
    "input_sha256",
    "input_bytes",
    "source_kind",
    "identity_authority",
    "complete_definition",
    "candidate_count",
    "selected_fragment_ids",
    "retrievals",
    "sources",
    "headings",
    "fragments",
    "omitted_fragments",
    "omissions",
    "gaps",
    "budget",
    "selection_sha256",
    "selected_fragment_count",
    "not_selected_fragments",
    "budget_omitted_fragments",
    "diagnostics_truncated"
  ],
  "properties": {
    "schema": {
      "const": "kgdistiller-source-evidence-context-v1"
    },
    "projection": {
      "const": "kgdistiller-source-evidence-context-projection-v1"
    },
    "source_projection": {
      "const": "kgdistiller-source-evidence-bm25-v1"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_file_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    },
    "source_kind": {
      "const": "raw-source-evidence"
    },
    "identity_authority": {
      "type": "boolean",
      "const": false
    },
    "complete_definition": {
      "type": "boolean",
      "const": false
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3200
    },
    "selected_fragment_ids": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 0,
      "maxItems": 3200,
      "items": {
        "$ref": "#/$defs/fragmentId"
      }
    },
    "retrievals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/retrieval"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "headings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 19200,
      "items": {
        "$ref": "#/$defs/heading"
      }
    },
    "fragments": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3200,
      "items": {
        "$ref": "#/$defs/fragment"
      }
    },
    "omitted_fragments": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3200
    },
    "omissions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3200,
      "items": {
        "$ref": "#/$defs/omission"
      }
    },
    "gaps": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_budget",
        "used_bytes"
      ],
      "properties": {
        "byte_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      }
    },
    "selection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "selected_fragment_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3200
    },
    "not_selected_fragments": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3200
    },
    "budget_omitted_fragments": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3200
    },
    "diagnostics_truncated": {
      "type": "boolean"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "docId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "fragmentId": {
      "type": "string",
      "pattern": "^evidence:sha256:[0-9a-f]{64}$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "headingId": {
      "type": "string",
      "pattern": "^heading:sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "source_url",
        "source_version",
        "source_type",
        "hash_mode",
        "source_sha256",
        "raw_source_sha256",
        "normalized_source_sha256"
      ],
      "properties": {
        "doc_id": {
          "$ref": "#/$defs/docId"
        },
        "source_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "hash_mode": {
          "enum": [
            "raw-utf8",
            "normalized-utf8"
          ]
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading_id",
        "source_ref",
        "level",
        "text",
        "byte_start",
        "byte_end",
        "identity_authority"
      ],
      "properties": {
        "heading_id": {
          "$ref": "#/$defs/headingId"
        },
        "source_ref": {
          "$ref": "#/$defs/docId"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "byte_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "byte_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "identity_authority": {
          "const": false,
          "type": "boolean"
        }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "identity_authority",
        "complete_definition",
        "content_sha256",
        "projection_sha256",
        "byte_span",
        "block_byte_span",
        "fragment_type",
        "partial",
        "text",
        "fragment_id",
        "source_ref",
        "heading_refs",
        "origins"
      ],
      "properties": {
        "source_kind": {
          "const": "raw-source-evidence"
        },
        "identity_authority": {
          "const": false,
          "type": "boolean"
        },
        "complete_definition": {
          "const": false,
          "type": "boolean"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_span": {
          "$ref": "#/$defs/span"
        },
        "block_byte_span": {
          "$ref": "#/$defs/span"
        },
        "fragment_type": {
          "enum": [
            "paragraph",
            "heading",
            "table",
            "algorithm",
            "code"
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6144
        },
        "fragment_id": {
          "$ref": "#/$defs/fragmentId"
        },
        "source_ref": {
          "$ref": "#/$defs/docId"
        },
        "heading_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 19199
          }
        },
        "origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result_index",
              "rank",
              "score"
            ],
            "properties": {
              "result_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "score": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_index",
        "result_sha256",
        "query",
        "query_sha256",
        "doc_ids",
        "fragment_count",
        "matched_fragments",
        "requested_limit",
        "omitted_fragments",
        "diagnostics_truncated",
        "scoring",
        "budget",
        "returned_fragments",
        "reported_omissions"
      ],
      "properties": {
        "result_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "query_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "doc_ids": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/docId"
          }
        },
        "fragment_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "matched_fragments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "requested_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "omitted_fragments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "diagnostics_truncated": {
          "type": "boolean"
        },
        "scoring": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "k1",
            "b",
            "heading_weight",
            "identity_authority"
          ],
          "properties": {
            "method": {
              "const": "bm25"
            },
            "k1": {
              "const": 1.2
            },
            "b": {
              "const": 0.75
            },
            "heading_weight": {
              "const": 2
            },
            "identity_authority": {
              "const": false,
              "type": "boolean"
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "byte_budget",
            "used_bytes"
          ],
          "properties": {
            "byte_budget": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200000
            },
            "used_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200000
            }
          }
        },
        "returned_fragments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reported_omissions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragment_id",
        "reason"
      ],
      "properties": {
        "fragment_id": {
          "$ref": "#/$defs/fragmentId"
        },
        "reason": {
          "enum": [
            "fragment-exceeds-byte-budget",
            "not-selected"
          ]
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_index",
        "reason",
        "fragment_count",
        "reported_fragment_ids",
        "diagnostics_truncated"
      ],
      "properties": {
        "result_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "reason": {
          "enum": [
            "retrieval-byte-budget",
            "retrieval-limit"
          ]
        },
        "fragment_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "reported_fragment_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/fragmentId"
          }
        },
        "diagnostics_truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
