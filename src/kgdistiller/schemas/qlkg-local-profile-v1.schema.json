{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/qlkg-local-profile-v1.schema.json",
  "title": "kgdistiller machine-local profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "database", "portable_store", "embedding_profile", "provider_profiles"],
  "properties": {
    "schema": {"const": "qlkg-local-profile-v1"},
    "database": {"$ref": "#/$defs/localPath"},
    "portable_store": {"$ref": "#/$defs/localPath"},
    "embedding_profile": {"$ref": "#/$defs/profileName"},
    "provider_profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/profileName"},
      "additionalProperties": {"$ref": "#/$defs/providerProfile"}
    }
  },
  "$defs": {
    "localPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*[\\u0000\\r\\n]).+$"
    },
    "profileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "providerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model", "dimensions", "base_url", "credential_env"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "dimensions": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "base_url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https?://(?![^/?#]*@)[^\\s?#]+(?:/[^\\s?#]*)?$"},
        "credential_env": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      }
    }
  }
}
