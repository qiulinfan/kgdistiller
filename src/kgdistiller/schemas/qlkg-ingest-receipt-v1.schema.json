{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/qlkg-ingest-receipt-v1.schema.json",
  "title": "kgdistiller transactional ingest receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "request_sha256",
    "receipt_sha256",
    "engine",
    "before",
    "after",
    "changes",
    "validations",
    "durations_ms",
    "warnings",
    "status"
  ],
  "properties": {
    "schema": {"const": "qlkg-ingest-receipt-v1"},
    "request_id": {"type": "string"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "engine": {"type": "object"},
    "before": {"$ref": "#/$defs/state"},
    "after": {"$ref": "#/$defs/state"},
    "changes": {"type": "object"},
    "validations": {"type": "array", "items": {"type": "object"}},
    "durations_ms": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "warnings": {"type": "array"},
    "status": {"enum": ["committed", "rejected", "rolled-back"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {
      "type": "object",
      "required": ["graph_sha256", "alignment_sha256", "source_hashes"],
      "properties": {
        "graph_sha256": {"$ref": "#/$defs/sha256"},
        "alignment_sha256": {"$ref": "#/$defs/sha256"},
        "source_hashes": {"type": "object", "additionalProperties": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}
      }
    }
  }
}
