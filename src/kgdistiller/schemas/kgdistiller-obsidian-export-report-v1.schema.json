{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-obsidian-export-report-v1.schema.json",
  "title": "kgdistiller Obsidian export operation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "artifact_schema", "projection_sha256", "source",
    "policy", "counts", "output"
  ],
  "properties": {
    "schema": {"const": "kgdistiller-obsidian-export-report-v1"},
    "status": {"const": "verified"},
    "artifact_schema": {"const": "kgdistiller-obsidian-projection-v1"},
    "projection_sha256": {"$ref": "#/$defs/sha256"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_schema", "graph_sha256", "snapshot_sha256", "source_hashes_sha256"],
      "properties": {
        "graph_schema": {"const": "kgdistiller-graph-v1"},
        "graph_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "source_hashes_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "edge_semantics_in_obsidian_graph", "plugin_graph", "authority_links"],
      "properties": {
        "nodes": {"const": "active-knowledge"},
        "edges": {"const": "current-semantic"},
        "edge_semantics_in_obsidian_graph": {"const": "lossy"},
        "plugin_graph": {"const": "typed"},
        "authority_links": {"enum": ["vault-relative", "file-uri"]}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concepts", "sources", "links"],
      "properties": {
        "concepts": {"type": "integer", "minimum": 0},
        "sources": {"type": "integer", "minimum": 0},
        "links": {"type": "integer", "minimum": 0}
      }
    },
    "output": {"type": "string", "minLength": 1},
    "changed": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
