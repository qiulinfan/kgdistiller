{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-support-selection-v1.schema.json",
  "title": "Source-bound caller query support selection v1",
  "description": "Explicit support source choices; reasons, requirements and producer trace hashes do not attest relevance, scientific truth or identity equivalence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "namespace", "snapshot_sha256", "graph_sha256", "question_sha256", "plan_sha256", "identity_authority", "kind", "items"],
  "properties": {
    "schema": {"const": "kgdistiller-support-selection-v1"},
    "namespace": {"type": "string", "minLength": 1, "maxLength": 256},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "graph_sha256": {"$ref": "#/$defs/sha256"},
    "question_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "identity_authority": {"type": "boolean", "const": false},
    "kind": {"const": "caller-selected-query-support"},
    "items": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nodeId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_sha256", "document_sha256", "requirement_ids", "reason"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nodeId"},
        "node_sha256": {"$ref": "#/$defs/sha256"},
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "requirement_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
        "producer_trace_sha256": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
      }
    }
  }
}
