{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-context-bundle-v2.schema.json",
  "title": "kgdistiller complete graph support packets v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "question",
    "search_execution_schema",
    "search_result_schema",
    "edge_policy",
    "nodes",
    "edges",
    "support_packets",
    "gaps",
    "omissions",
    "omitted_support_packets",
    "diagnostics_truncated",
    "budget"
  ],
  "properties": {
    "schema": {
      "const": "kgdistiller-context-bundle-v2"
    },
    "question": {
      "type": "string"
    },
    "search_execution_schema": {
      "const": "kgdistiller-search-execution-v3"
    },
    "search_result_schema": {
      "const": "kgdistiller-search-result-v3"
    },
    "edge_policy": {
      "enum": [
        "all",
        "high-confidence"
      ]
    },
    "nodes": {
      "type": "array",
      "maxItems": 4500,
      "items": {
        "type": "object"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 4000,
      "items": {
        "type": "object"
      }
    },
    "support_packets": {
      "type": "array",
      "maxItems": 532,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "kind",
          "nodes",
          "path",
          "logical_entailment"
        ],
        "properties": {
          "node_id": {
            "$ref": "#/$defs/nodeId"
          },
          "kind": {
            "enum": [
              "graph-path",
              "direct-source"
            ]
          },
          "nodes": {
            "type": "array",
            "maxItems": 9,
            "items": {
              "$ref": "#/$defs/nodeId"
            }
          },
          "path": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/pathEvidence"
              }
            ]
          },
          "logical_entailment": {
            "const": false
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 532,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "reason"
        ],
        "properties": {
          "node_id": {
            "$ref": "#/$defs/nodeId"
          },
          "reason": {
            "const": "support-packet-exceeds-budget"
          }
        }
      }
    },
    "omissions": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object"
      }
    },
    "omitted_support_packets": {
      "type": "integer",
      "minimum": 0,
      "maximum": 532
    },
    "diagnostics_truncated": {
      "type": "boolean"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_budget",
        "estimated_tokens"
      ],
      "properties": {
        "token_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        }
      }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "edgeType": {
      "enum": [
        "prerequisite-for",
        "implies",
        "generalizes",
        "contrasts-with",
        "derived-from"
      ]
    },
    "pathStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "relation",
        "target",
        "direction",
        "confidence",
        "evidence",
        "purpose",
        "logical_entailment"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/nodeId"
        },
        "relation": {
          "$ref": "#/$defs/edgeType"
        },
        "target": {
          "$ref": "#/$defs/nodeId"
        },
        "direction": {
          "enum": [
            "outgoing",
            "incoming"
          ]
        },
        "confidence": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "purpose": {
          "enum": [
            "learning-prerequisite",
            "source-derivation",
            "comparison",
            "relation-navigation"
          ]
        },
        "logical_entailment": {
          "const": false
        }
      }
    },
    "pathEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "nodes",
        "edge_types",
        "steps",
        "logical_entailment"
      ],
      "properties": {
        "lane": {
          "enum": [
            "graph",
            "ppr"
          ]
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "edge_types": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/edgeType"
          }
        },
        "steps": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/pathStep"
          }
        },
        "logical_entailment": {
          "const": false
        }
      }
    }
  }
}
