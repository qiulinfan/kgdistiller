{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgdistiller.dev/schemas/kgdistiller-ingest-receipt-v1.schema.json",
  "title": "kgdistiller transactional ingest receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "status", "request", "changes", "counts"],
  "properties": {
    "schema": {"const": "kgdistiller-ingest-receipt-v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"},
    "status": {"const": "committed"},
    "request": {"type": "object", "required": ["schema", "request_id", "mode", "capabilities", "delta", "review"], "properties": {"schema": {"const": "kgdistiller-ingest-request-v1"}, "mode": {"const": "apply"}}},
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries_created", "entries_updated", "entries_removed", "aliases_changed", "edges_added", "edges_removed"],
      "properties": {
        "entries_created": {"$ref": "#/$defs/ids"},
        "entries_updated": {"$ref": "#/$defs/ids"},
        "entries_removed": {"$ref": "#/$defs/ids"},
        "aliases_changed": {"$ref": "#/$defs/ids"},
        "edges_added": {"$ref": "#/$defs/edgeKeys"},
        "edges_removed": {"$ref": "#/$defs/edgeKeys"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "edges"],
      "properties": {
        "entries": {"type": "integer", "minimum": 0},
        "edges": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "edgeKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "relation", "target"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
