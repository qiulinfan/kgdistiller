{
  "name": "kgdistiller-obsidian",
  "version": "0.1.5",
  "description": "Typed, source-backed kgdistiller graph view for Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "keywords": [
    "obsidian",
    "knowledge-base",
    "kgdistiller"
  ],
  "author": "Qiulin Fan",
  "license": "MIT",
  "dependencies": {
    "cytoscape": "3.34.1",
    "cytoscape-fcose": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "typescript": "^5.8.3",
    "vitest": "4.1.11"
  }
}
